{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "target": "ES2020",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "react"
    ],
    "incremental": false
  },
  "files": [
    "next-env.d.ts",
    "lib/pageviews.ts",
    "lib/pageview-path.ts",
    "components/PageViewTracker.tsx",
    "app/api/track/pv/route.ts",
    "app/api/admin/traffic/route.ts",
    "app/admin/traffic/page.tsx",
    "components/AdminShell.tsx",
    "app/layout.tsx"
  ]
}