{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "target": "ES2020",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "react"
    ],
    "incremental": false
  },
  "files": [
    "lib/gigs-server.ts",
    "app/api/account/profile/route.ts",
    "app/api/hire/route.ts",
    "app/api/gig-manage/[token]/route.ts",
    "app/gig-manage/[token]/page.tsx",
    "app/api/admin/gigs/route.ts",
    "app/admin/gigs/page.tsx",
    "app/api/gigs/[id]/route.ts",
    "app/account/gigs/[id]/page.tsx",
    "app/account/gigs/page.tsx",
    "app/account/hire/page.tsx"
  ]
}