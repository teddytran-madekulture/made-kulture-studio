{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "target": "ES2020",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "react"
    ],
    "incremental": false
  },
  "files": [
    "app/api/checkin/[token]/route.ts",
    "app/checkin/[token]/page.tsx",
    "lib/igloohome.ts",
    "lib/email.ts",
    "app/api/admin/bookings/[id]/issue-door-code/route.ts",
    "app/manage/[token]/page.tsx",
    "app/account/bookings/page.tsx",
    "lib/support-faq.ts",
    "lib/reminder-text.ts"
  ]
}