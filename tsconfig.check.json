    "lib/site-content.ts",
    "lib/push.ts",
    "app/admin/inbox/page.tsx",
    "components/AdminPwa.tsx",
    "app/api/admin/push/route.ts",
    "app/api/kiosk/extend/route.ts",
    "app/api/extensions/[token]/route.ts",
    "app/kiosk/layout.tsx",
    "lib/floor-status.ts",
