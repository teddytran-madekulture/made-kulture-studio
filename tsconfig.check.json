{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "target": "ES2020",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "react"
    ],
    "incremental": false
  },
  "files": [
    "app/admin/dashboard/page.tsx",
    "app/api/admin/bookings/route.ts",
    "app/api/admin/charge/route.ts",
    "app/api/admin/bookings/[id]/route.ts",
    "lib/booking-times.ts",
    "lib/igloohome.ts"
  ]
}