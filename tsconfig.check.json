    "app/api/account/short-notice-request/route.ts",
    "app/api/short-notice/[token]/route.ts",
    "app/api/pay/[token]/route.ts",
    "app/pay/[token]/page.tsx",
    "app/short-notice/approve/[token]/page.tsx",
    "app/book/BookClient.tsx",
    "app/admin/dashboard/page.tsx",
    "app/api/admin/short-notice-requests/route.ts",
    "app/api/account/bookings/[id]/reschedule/route.ts",
    "lib/set-availability.ts",
    "lib/coverage.ts",
    "app/account/bookings/page.tsx",
    "components/RescheduleModal.tsx",
