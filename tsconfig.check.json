{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "target": "es2017",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "types": ["node", "react"]
  },
  "files": [
    "lib/player-rev.ts",
    "app/api/version/route.ts",
    "app/api/admin/jukebox/control/route.ts",
    "app/jukebox/player/page.tsx",
    "app/admin/jukebox/page.tsx",
    "app/kiosk/page.tsx"
  ]
}
