{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "target": "ES2020",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "react"
    ],
    "incremental": false
  },
  "files": [
    "lib/second-profile.ts",
    "app/api/account/second-profile/route.ts",
    "components/SecondProfileEditor.tsx",
    "components/RosterAboutEditor.tsx",
    "app/api/account/roster/route.ts",
    "app/api/directory/[id]/route.ts",
    "app/account/directory/[id]/page.tsx",
    "app/account/profile/page.tsx",
    "lib/roles.ts",
    "lib/directory-stats.ts"
  ]
}
