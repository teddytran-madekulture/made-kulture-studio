{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "target": "ES2020",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "react"
    ],
    "incremental": false
  },
  "files": [
    "components/SetVideo.tsx",
    "components/SetsCatalogManager.tsx",
    "app/sets/[slug]/page.tsx",
    "app/HomeClient.tsx",
    "lib/site-images.ts",
    "app/api/admin/sets/route.ts",
    "app/api/admin/sets/[id]/route.ts",
    "app/api/admin/sets/upload/route.ts"
  ]
}
