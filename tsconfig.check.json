{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "target": "es2017",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "types": ["node", "react"]
  },
  "files": [
    "lib/coverage.ts",
    "lib/shifts.ts",
    "app/admin/shifts/page.tsx",
    "app/api/extensions/[token]/route.ts",
    "app/api/desk/bookings/[id]/add-time/route.ts",
    "app/api/admin/bookings/[id]/route.ts",
    "app/api/admin/shifts/route.ts"
  ]
}
