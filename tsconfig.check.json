{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "target": "es2017",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "react"
    ]
  },
  "files": [
    "components/AdminShell.tsx",
    "components/AddChargeModal.tsx",
    "components/AddSetModal.tsx",
    "components/SetGallery.tsx",
    "components/PageEditor.tsx",
    "components/WebsiteShell.tsx",
    "app/admin/dashboard/page.tsx",
    "app/admin/shifts/page.tsx",
    "app/admin/payroll/page.tsx",
    "app/admin/workers/page.tsx",
    "app/admin/stack/page.tsx",
    "app/desk/page.tsx",
    "app/staff/page.tsx",
    "app/work/layout.tsx",
    "app/checkin/page.tsx",
    "app/account/directory/[id]/page.tsx",
    "app/admin/inbox/page.tsx"
  ]
}
